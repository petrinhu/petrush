# /etc/petrush/pudo.allow.example
# Copie para /etc/petrush/pudo.allow
# O arquivo DEVE ser:
#   - owned by root
#   - mode 0644 ou mais restrito (sem write para group/other)
#   - um caminho absoluto por linha
#   - comentários com #
#
# Exemplo intencionalmente mínimo (só inocentes). NÃO copie apt/dnf/systemctl/passwd.

/usr/bin/id
/usr/bin/whoami
/usr/bin/true
